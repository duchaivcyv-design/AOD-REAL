<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- NHÓM CÔNG TẮC CHÍNH -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Cấu hình tổng</string>
            <key>footerText</key>
            <string>Ép kích hoạt Always-On Display gốc và nạp chuỗi điều phối xung nhịp tầng sâu.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Bật Always-On Display</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>enabled</string>
            <key>default</key>
            <false/>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM CẤU HÌNH TẦN SỐ QUÉT (HZ / FPS) -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Tần số quét AOD tĩnh (2 - 20 Hz)</string>
            <key>footerText</key>
            <string>Khóa khung hình render ở mức cực thấp khi màn hình khóa tĩnh. Khi có thông báo đến, xung nhịp tự động bung lên 50 Hz trong 3.5 giây rồi hạ về mức này.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>CustomAODRefreshRate</string>
            <key>min</key>
            <real>2.0</real>
            <key>max</key>
            <real>20.0</real>
            <key>default</key>
            <real>2.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <false/>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM CẤU HÌNH ĐỘ SÁNG MÀN HÌNH -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Độ sáng nền AOD (Mức 2 - 20)</string>
            <key>footerText</key>
            <string>Mức 2 tương đương ~0.2% độ sáng phần cứng (rất tối trong bóng đêm). Mức 20 tương đương ~2.0% độ sáng.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>CustomAODBrightness</string>
            <key>min</key>
            <real>2.0</real>
            <key>max</key>
            <real>20.0</real>
            <key>default</key>
            <real>5.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <false/>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM HÀNH ĐỘNG -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Hành động</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Respring (Áp dụng thay đổi)</string>
            <key>action</key>
            <string>respring</string>
        </dict>
    </array>
</dict>
</plist>
