<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- NHÓM CÔNG TẮC CHÍNH -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Cấu hình tổng</string>
            <key>footerText</key>
            <string>Kích hoạt Always-On Display gốc và nạp chuỗi điều phối xung nhịp tầng sâu.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Bật Always-On Display</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>enabled</string>
            <key>default</key>
            <true/>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM CẤU HÌNH TẦN SỐ QUÉT (HZ / FPS) -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Tần số quét AOD tĩnh (2 - 30 Hz)</string>
            <key>footerText</key>
            <string>Khóa khung hình render ở mức cực thấp khi màn hình khóa tĩnh. Khi có tương tác hoặc chạm, xung nhịp tự phục hồi mượt mà.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>CustomAODRefreshRate</string>
            <key>min</key>
            <real>2.0</real>
            <key>max</key>
            <real>30.0</real>
            <key>default</key>
            <real>2.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>28</integer>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM CẤU HÌNH ĐỘ SÁNG MÀN HÌNH -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Độ sáng nền AOD (Mức 1 - 30)</string>
            <key>footerText</key>
            <string>Mức 1 tương đương độ sáng panel tối thiểu (~0.1%). Mức 30 tương đương ~3.0% độ sáng.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>defaults</key>
            <string>com.jb.aodreal</string>
            <key>key</key>
            <string>CustomAODBrightness</string>
            <key>min</key>
            <real>1.0</real>
            <key>max</key>
            <real>30.0</real>
            <key>default</key>
            <real>8.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>29</integer>
            <key>PostNotification</key>
            <string>com.jb.aodreal/preferences.changed</string>
        </dict>

        <!-- NHÓM HÀNH ĐỘNG -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Hành động</string>
            <key>footerText</key>
            <string>Khởi động lại SpringBoard để làm mới toàn bộ bộ nhớ đệm nếu cần.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Respring (Áp dụng thay đổi)</string>
            <key>action</key>
            <string>respring</string>
        </dict>
    </array>
</dict>
</plist>
